<Window x:Class="CompaterShopWpf.Windows.ItemWindow.ItemInfo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:CompaterShopWpf.Windows.ItemWindow"
        mc:Ignorable="d"
        Title="Покупка предмета" Height="300" Width="400">
    <Grid>
        <StackPanel Margin="10">
            <TextBlock Text="Название:" FontWeight="Bold"/>
            <TextBlock Text="{Binding Item.Name}"/>
            <TextBlock Text="Описание:" FontWeight="Bold" Margin="0,10,0,0"/>
            <TextBlock Text="{Binding Item.Description}"/>
            <TextBlock Text="Цена:" FontWeight="Bold" Margin="0,10,0,0"/>
            <TextBlock Text="{Binding Item.Price, StringFormat=C}"/>
            <TextBlock Text="Категория:" FontWeight="Bold" Margin="0,10,0,0"/>
            <TextBlock Text="{Binding Item.Category.CategoryName}"/>
            <TextBlock Text="Количество:" FontWeight="Bold" Margin="0,10,0,0"/>
            <TextBox Text="{Binding Count}"/>
        </StackPanel>
        <StackPanel VerticalAlignment="Bottom" Margin="5">
            <Button Content="Добавить в корзину" Command="{Binding AddToBacketCommand}" Margin="10, 5, 10, 0" />
            <Button Content="Удалить из корзины" Command="{Binding RemoveFromBacketCommand}" Margin="10, 5, 10, 10" />
        </StackPanel>
    </Grid>
</Window>
