<Window x:Class="CompaterShopWpf.Windows.BacketWindow.BacketInfo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        mc:Ignorable="d" 
        d:DesignHeight="250" d:DesignWidth="500">
    <Grid>
        
        <!-- Основное содержимое: две колонки -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

        <!-- кнопка закрытия -->
        <Button Grid.Column="1" Click="ButtonBase_OnClick" 
                Content="Закрыть" 
                VerticalAlignment="Top" 
                HorizontalAlignment="Right" 
                Margin="0,20,20,0" 
                Width="100"/>
        
            <!-- Корзина -->
            <Grid Grid.Column="0" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Text="Ваша корзина" 
                           FontSize="24" 
                           HorizontalAlignment="Center" 
                           Margin="0,10,0,20"/>
                
                <TextBlock Grid.Row="0"
                    Grid.Column="0"
                    VerticalAlignment="Bottom"
                    FontStyle="Italic"
                    Foreground="Gray"
                    Text="для удаления товара нажмите на него*"/>
                
                <ListView Grid.Row="1" ItemsSource="{Binding Items}" 
                          SelectionChanged="ListView_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="{Binding Item.Name}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Item.Description}"/>
                                <TextBlock Text="{Binding Item.Price, StringFormat='C'}" Foreground="Green"/>
                                <TextBlock Text="{Binding Item.Category.CategoryName}" FontStyle="Italic"/>
                                <TextBlock Text="{Binding Count, StringFormat='кол-во {0}'}" FontStyle="Italic"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                
            </Grid>

            <!-- Вторая колонка: Оплата -->
            <StackPanel Grid.Column="1" Margin="20,0,0,40" VerticalAlignment="Center">
                <TextBlock Text="{Binding TotalPrice, StringFormat=' {0:C}'}" 
                           FontSize="28"
                           Foreground="Green"
                           FontStyle="Italic"
                           HorizontalAlignment="Center" 
                           Margin="0,0,20,10"/>
                <ComboBox ItemsSource="{Binding Cards}" 
                          SelectedItem="{Binding SelectedCard}" 
                          DisplayMemberPath="CardNumber" 
                          Width="200" 
                          HorizontalAlignment="Left"/>
                <Button Content="Добавить новую карту" 
                        Command="{Binding AddNewCardCommand}" 
                        Width="200" 
                        HorizontalAlignment="Left" 
                        Margin="0,10,0,0"/>
            </StackPanel>
        
        <StackPanel Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="20">
            <Button Command="{Binding BuyBacketCommand}" 
                    Content="Оплатить корзину" 
                    Width="200" 
                    HorizontalAlignment="Left" 
                    Margin="0,10,0,0" 
                    Height="25"/>
                    
            
        </StackPanel>
        </Grid>
</Window>