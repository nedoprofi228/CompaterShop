<Window x:Class="CompaterShopWpf.Windows.OrderStatisticWindow.OrderStatistic"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chartingToolkit="clr-namespace:System.Windows.Controls.DataVisualization.Charting;assembly=DotNetProjects.DataVisualization.Toolkit"
        mc:Ignorable="d"
        Title="Статистика покупок" Height="600" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Выпадающий список выбора периода -->
        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="5">
            <TextBlock Text="Период:" VerticalAlignment="Center"/>
            <ComboBox ItemsSource="{Binding Periods}" 
                      SelectedItem="{Binding SelectedPeriod}" 
                      Width="100" Margin="5"/>
        </StackPanel>

        <!-- Таблица заказов -->
        <DataGrid Grid.Row="1" Grid.Column="0" 
                  ItemsSource="{Binding FilteredOrders}" 
                  AutoGenerateColumns="False" 
                  IsReadOnly="True"
                  Margin="5">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата заказа" Binding="{Binding OrderDate, StringFormat={}{0:dd.MM.yyyy}}"/>
                <DataGridTextColumn Header="Цена заказа" Binding="{Binding TotalPrice, StringFormat={}{0:C}}"/>
                <DataGridTextColumn Header="Товары" Binding="{Binding ItemsString}"/>
                <DataGridTextColumn Header="Имя пользователя" Binding="{Binding UserName}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Выпадающий список выбора данных для диаграммы -->
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="5">
            <TextBlock Text="Данные диаграммы:" VerticalAlignment="Center"/>
            <ComboBox ItemsSource="{Binding DiagramDataTypes}" 
                      SelectedItem="{Binding SelectedDiagramDataType}" 
                      Width="150" Margin="5"/>
        </StackPanel>

        <!-- Круговая диаграмма -->
        <chartingToolkit:Chart Grid.Row="1" Grid.Column="1" Margin="5">
            <chartingToolkit:PieSeries ItemsSource="{Binding PieChartData}" 
                                       DependentValuePath="Value" 
                                       IndependentValuePath="ItemName"/>
        </chartingToolkit:Chart>
    </Grid>
</Window>