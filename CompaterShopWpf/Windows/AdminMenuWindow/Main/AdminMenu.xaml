<Window x:Class="CompaterShopWpf.Windows.AdminMenuWindow.AdminMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:CompaterShopWpf.Windows.AdminMenuWindow"
        mc:Ignorable="d"
        Title="Админ меню" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Button Grid.Row="0" Grid.Column="0" Command="{Binding OpenOrdersHistoryCommand}" Width="150" Height="20" Margin="10" HorizontalAlignment="Left" Content="история операций" />
        <Button Grid.Column="2" Grid.Row="0" Click="ButtonBase_OnClick" HorizontalAlignment="Right" Margin="10" Width="100" Content="закрыть"/>
        <!-- Каталоги -->
        <StackPanel Grid.Row="1" Grid.Column="0" Margin="5">
            <TextBlock Text="Каталоги" HorizontalAlignment="Center" FontWeight="Bold"/>
            <ListBox ItemsSource="{Binding Catalogs}" 
                     SelectedItem="{Binding SelectedCatalog}" 
                     DisplayMemberPath="Name" Height="300"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Добавить" Command="{Binding AddCatalogCommand}" Margin="5"/>
                <Button Content="Изменить" Command="{Binding EditCatalogCommand}" Margin="5"/>
                <Button Content="Удалить" Command="{Binding DeleteCatalogCommand}" Margin="5"/>
            </StackPanel>
        </StackPanel>

        <!-- Категории -->
        <StackPanel Grid.Row="1" Grid.Column="1" Margin="5">
            <TextBlock Text="Категории" HorizontalAlignment="Center" FontWeight="Bold"/>
            <ListBox ItemsSource="{Binding SelectedCatalogCategories}" 
                     SelectedItem="{Binding SelectedCategory}" 
                     DisplayMemberPath="CategoryName" Height="300"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Добавить" Command="{Binding AddCategoryCommand}" Margin="5"/>
                <Button Content="Изменить" Command="{Binding EditCategoryCommand}" Margin="5"/>
                <Button Content="Удалить" Command="{Binding DeleteCategoryCommand}" Margin="5"/>
            </StackPanel>
        </StackPanel>

        <!-- Предметы -->
        <StackPanel Grid.Row="1" Grid.Column="2" Margin="5">
            <TextBlock Text="Предметы" HorizontalAlignment="Center" FontWeight="Bold"/>
            <ListBox 
                ItemsSource="{Binding SelectedCategoryItems}"
                SelectedItem="{Binding SelectedItem}"
                Height="300">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}"/>
                            <TextBlock Text="{Binding Description}"/>
                            <TextBlock Text="{Binding Price, StringFormat='Цена: {0:C}'}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Добавить" Command="{Binding AddItemCommand}" Margin="5"/>
                <Button Content="Изменить" Command="{Binding EditItemCommand}" Margin="5"/>
                <Button Content="Удалить" Command="{Binding DeleteItemCommand}" Margin="5"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
