<Window x:Class="CompaterShopWpf.Windows.NewCardWindow.NewCard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить новую карту" 
        Height="250" 
        Width="400">
    <Grid Margin="20">
        <StackPanel>
            
            <!-- Номер карты -->
            <TextBlock Text="Номер карты:" 
                       HorizontalAlignment="Center" 
                       Margin="0, 0,10,10"/>
            <TextBox Text="{Binding CardNumber, UpdateSourceTrigger=PropertyChanged}" 
                     Width="200" 
                     HorizontalAlignment="Center"/>
            
            <!-- Баланс -->
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Начальный баланс:" 
                       HorizontalAlignment="Center" Margin="0,10,10,0"/>
            <TextBox Text="{Binding Balance, UpdateSourceTrigger=PropertyChanged}" 
                     Width="200" 
                     HorizontalAlignment="Center"
                     Margin="0,10,0,0"/>

            
            <!-- Сообщение об ошибке -->
            <TextBlock 
                HorizontalAlignment="Center"
                Text="{Binding ErrorMessage}" 
                Foreground="Red"
                TextWrapping="Wrap" 
                Margin="0,10,0,0"/>
        </StackPanel>
        
        <!-- кнопки -->
        <StackPanel 
            Orientation="Horizontal" 
            HorizontalAlignment="Right"
            Margin="0,20,0,0"
            VerticalAlignment="Bottom">
            <Button Content="Отмена" Width="100" Click="Cancle_OnClick" />
            <Button Content="Сохранить" Width="100" Click="SaveButton_Click" Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>