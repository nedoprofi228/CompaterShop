<Window x:Class="CompaterShopWpf.Windows.SignUp"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:CompaterShopWpf.Windows"
        mc:Ignorable="d"
        Title="Login" Height="350" Width="350">
    <Grid>
        <Grid Width="250" VerticalAlignment="Center" HorizontalAlignment="Center" >
            <StackPanel>
            <TextBlock Grid.Row="0" HorizontalAlignment="Center" Width="150" TextAlignment="Center" FontWeight="Bold" Margin="10" Text="Sing up"  />
            <Label Grid.Row="1" HorizontalAlignment="Center">Username</Label>
            <TextBox Grid.Row="2" x:Name="UserNameEl" Text="{Binding Username}" HorizontalAlignment="Center" Width="150" Height="20"/>
            <Label Grid.Row="3" HorizontalAlignment="Center">Login</Label>
            <TextBox Grid.Row="4" x:Name="LoginEl" Text="{Binding Login}" HorizontalAlignment="Center" Width="150" Height="20"/>
            <Label Grid.Row="5" HorizontalAlignment="Center">Password</Label>
            <TextBox Grid.Row="6" x:Name="PasswordEl" Text="{Binding Password}" HorizontalAlignment="Center" Width="150" Height="20" />
            <Button  Grid.Row="7" x:Name="EnterBtn" Command="{Binding EnterCommand}" HorizontalAlignment="Center" BorderThickness="0" Background="White" Width="60" Margin="10" Content="Enter" />
            <Button Grid.Row="8" x:Name="RegisterBtn" Command="{Binding ToSignInCommand}" BorderThickness="0" Background="White" Width="50" Margin="0,0,0,10" Content="Sign In" /> 
            <Button Content="Пользовательское соглашение"
                    Command="{Binding OpenAgreeeCommand}"
                    HorizontalAlignment="Center" 
                    Margin="0,0,0,10" 
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="Blue" 
                    Cursor="Hand"
                    />
                
            </StackPanel>
        </Grid>
    </Grid>
</Window>
